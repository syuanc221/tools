# 由 ./ro.sh setup 自動產生 .env；要改設定就改 .env 再 ./ro.sh restart

# 伺服器名稱
SERVER_NAME=MyRO

# 純 PvP 模式：出生在普隆德拉、PvP 大師一鍵練滿、可用 @item 拿裝備
PVP_MODE=yes

# 遊戲版本（改了要 ./ro.sh rebuild）
#   PRERE=yes 是經典版（復興前），PACKETVER 是客戶端日期，越舊介面越古早
PRERE=yes
PACKETVER=20130618

# 文字編碼：1 = 英文/韓文素材，14 = 台灣繁中素材
LANGTYPE=1

# 網頁客戶端的埠：瀏覽器打開 http://localhost:3338
WEB_PORT=3338

# 要給同一個 Wi-Fi 的朋友連：
#   PUBLIC_IP 改成這台 Mac 的區網 IP（例如 192.168.1.20），BIND_ADDR 改成 0.0.0.0
#   朋友用瀏覽器開 http://192.168.1.20:3338
PUBLIC_IP=127.0.0.1
BIND_ADDR=127.0.0.1

# 允許在登入畫面用 帳號_M / 帳號_F 直接註冊新帳號
ALLOW_REGISTER=yes
# 進角色前的 PIN 碼
PINCODE=no

# 以下由 setup 隨機產生，不用動
DB_PASS=
INTER_USER=s1
INTER_PASS=
