# 由 ./ro.sh setup 自動產生 .env；要改設定就改 .env 再 ./ro.sh restart

# 伺服器名稱（選角畫面上顯示）
SERVER_NAME=MyRO

# 要跟客戶端 exe 日期一致；改了之後要 ./ro.sh rebuild
PACKETVER=20211103

# 告訴客戶端要連哪個 IP。
#   只有自己這台 Mac 玩：127.0.0.1
#   要給同一個 Wi-Fi 的朋友連：改成這台 Mac 的區網 IP（例如 192.168.1.20），並把 BIND_ADDR 改成 0.0.0.0
PUBLIC_IP=127.0.0.1
BIND_ADDR=127.0.0.1

# 允許在登入畫面用 帳號_M / 帳號_F 直接註冊新帳號
ALLOW_REGISTER=yes
# 進角色前的 PIN 碼
PINCODE=no

# 以下由 setup 隨機產生，不用動
DB_PASS=
INTER_USER=s1
INTER_PASS=
